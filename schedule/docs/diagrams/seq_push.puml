@startuml プッシュ通知を送る
  actor タイマー as T
  control "send_due_alerts" as C1
  entity スケジュール as E1
  entity アラート設定 as E2
  entity 通知ログ as E3
  entity プッシュ通知の送り先 as E4
  boundary "プッシュサービス" as B1
  boundary "sw.js" as B2
  actor 一般ユーザー as AC

  == 1回目の通知 ==
  T -> C1 : 起動()（毎分）
  C1 -> E1 : 参照()
  C1 <-- E1
  C1 -> E2 : 参照()
  C1 <-- E2
  alt 通知する時刻になっていない場合、またはアラートがオフの場合
    C1 -> C1 : 何もしない
  else 通知する時刻になっている場合
    C1 -> E3 : 登録()
    alt 今日すでに送信済みの場合
      C1 -> C1 : 何もしない
    else それ以外の場合
      C1 -> E4 : 参照()
      C1 <-- E4
      C1 -> B1 : プッシュ通知を送信する
      alt 送り先が無効な場合（404・410）
        C1 -> E4 : 削除()
      else それ以外の場合
        B1 -> B2 : 通知を届ける
        B2 -> AC : 通知を表示する
      end
    end
  end

  == 対応しなかったとき（再通知） ==
  C1 -> E3 : 参照()
  C1 <-- E3
  alt 確認済み、再通知済み、または再通知の時刻になっていない場合
    C1 -> C1 : 何もしない
  else 再通知の時刻になっている場合
    C1 -> E3 : 更新()
    C1 -> B1 : もう一度プッシュ通知を送信する
    B1 -> B2 : 通知を届ける
    B2 -> AC : 通知を表示する
  end
@enduml