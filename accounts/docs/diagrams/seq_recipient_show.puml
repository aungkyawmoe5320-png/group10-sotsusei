@startuml 要介護者の設定を表示する
  actor 一般ユーザー as AC
  boundary "account_detail.html" as B1
  control "urls.py" as C0
  control "care_recipient_edit" as C1
  entity 要介護者 as E1
  boundary "404エラー画面" as B2
  boundary "care_recipient_form.html" as B3

  AC -> B1 : 「設定」ボタンを押下する
  B1 -> C0 : GET
  C0 -> C1 : 起動()
  C1 -> E1 : 参照()
  C1 <-- E1
  alt 自分の要介護者が見つからない場合
    C1 -> B2 : 404エラーを表示する
  else 見つかった場合
    C1 -> B3 : 入力済みの入力画面を表示する
  end
@enduml