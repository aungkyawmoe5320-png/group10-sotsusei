@startuml ログアウトする
  actor 一般ユーザー as AC
  boundary "account_detail.html" as B1
  control "urls.py" as C0
  control "logout_view" as C1
  control "login_view" as C2
  boundary "login.html" as B2

  AC -> B1 : 「ログアウト」ボタンを押下する
  B1 -> C0 : POST
  C0 -> C1 : 起動()
  C1 -> C1 : ログアウトする
  C1 -> C0 : リダイレクト()
  C0 -> C2 : 起動()
  C2 -> B2 : 「ログアウトしました。」\nとメッセージを表示し\nログイン画面を表示する
@enduml