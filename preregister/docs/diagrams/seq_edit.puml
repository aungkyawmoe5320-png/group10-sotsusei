@startuml 事前登録編集

    actor    一般ユーザー          as AC
    boundary detail.html           as B1
    control  urls.py               as C0
    control  preregister_edit      as C1
    entity   事前登録              as E1
    boundary form.html             as B2
    control  preregister_detail    as C2
    control  preregister_list      as C3
    boundary list.html             as B3

    AC -> B1 : 「編集」ボタンを押下する
    B1 -> C0 : GET
    C0 -> C1 : 起動()
    C1 -> E1 : 参照()
    C1 <-- E1 :
    alt 本人の事前登録が見つからない場合
        C1 -> C0 : リダイレクト()
        C0 -> C3 : 起動()
        C3 -> B3 : 一覧を表示する
    else 見つかった場合
        C1 -> B2 : 入力済みの入力画面を表示する
        AC -> B2 : 内容を変更し\n「保存する」ボタンを押下する
        B2 -> C0 : POST
        C0 -> C1 : 起動()
        alt 注意事項が未入力の場合
            C1 -> B2 : 「注意事項を入力してください。」\nとメッセージを表示する
        else 身体状況が未入力の場合
            C1 -> B2 : 「身体状況を入力してください。」\nとメッセージを表示する
        else 文字数が上限を超えている場合
            C1 -> B2 : 「〇〇は50文字以内で入力してください。」\nとメッセージを表示する
        else それ以外の場合
            C1 -> E1 : 更新(事前登録と薬)
            C1 <-- E1 :
            C1 -> C0 : リダイレクト()
            C0 -> C2 : 起動()
            C2 -> B1 : 「事前登録を更新しました。」\nとメッセージを表示し\n詳細を表示する
        end
    end

@enduml